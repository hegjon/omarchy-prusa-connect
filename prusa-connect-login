#!/usr/bin/env python3

"""Sign in to Prusa Connect for the Omarchy Prusa Connect plugin.

Two ways in:

  prusa-connect-login              Sign in with your Prusa account email and
                                   password (and TOTP code, if 2FA is on),
                                   the way the Prusa mobile app does.
  prusa-connect-login --paste      Paste a refresh token you copied from a
                                   signed-in browser session, for when the
                                   sign-in form has changed under us.

  prusa-connect-login --status     Report whether credentials are present.
  prusa-connect-login --forget     Remove them.

Only the refresh token is kept, and only in the GNOME keyring. The password is
sent once, over HTTPS, to account.prusa3d.com and nowhere else; it is never
stored, never logged, and never passed on the command line.
"""

from __future__ import annotations

import argparse
import base64
import getpass
import hashlib
import http.cookiejar
import json
import os
import re
import secrets
import shutil
import subprocess
import sys
import urllib.error
import urllib.parse
import urllib.request

PLUGIN_ID = "hegjon.prusa-connect"
CLIENT_ID = "MRHTlZhZqkNrrQ6FUPtjyusAz8nc59ErHXP8XkS4"
ACCOUNT_HOST = "account.prusa3d.com"
AUTHORIZE_URL = f"https://{ACCOUNT_HOST}/o/authorize/"
TOKEN_URL = f"https://{ACCOUNT_HOST}/o/token/"
# The redirect registered for Prusa's client: Connect's own sign-in callback.
# The credential flow never loads it — the authorization code is lifted from
# the redirect that points there.
CONNECT_REDIRECT_URI = "https://connect.prusa3d.com/login/auth-callback"
# The scope Connect's own web token carries, read from its JWT claims.
SCOPE = "basic_info user_operations email_lists openid connect"
USER_AGENT = "omarchy-prusa-connect/0.3.0"

STATE_DIR = os.path.join(
    os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")),
    "omarchy",
    "prusa-connect",
)
ACCOUNT_FILE = os.path.join(STATE_DIR, "account")


class LoginError(Exception):
    """Something the user can act on."""


# --- keyring -----------------------------------------------------------------


def secret_tool() -> str:
    path = shutil.which("secret-tool")
    if not path:
        raise LoginError("secret-tool is not installed (package: libsecret)")
    return path


def store_refresh_token(account: str, token: str) -> None:
    proc = subprocess.run(
        [
            secret_tool(), "store",
            "--label=Prusa Connect refresh token",
            "application", PLUGIN_ID,
            "account", account,
        ],
        input=token.encode(),
        capture_output=True,
    )
    if proc.returncode != 0:
        raise LoginError(
            "could not write to the GNOME keyring — is your login keyring unlocked?"
        )


def lookup_refresh_token(account: str) -> str | None:
    proc = subprocess.run(
        [secret_tool(), "lookup", "application", PLUGIN_ID, "account", account],
        capture_output=True,
    )
    if proc.returncode != 0:
        return None
    token = proc.stdout.decode().rstrip("\r\n")
    return token or None


def clear_credentials() -> None:
    account = stored_account()
    if account:
        subprocess.run(
            [secret_tool(), "clear", "application", PLUGIN_ID, "account", account],
            capture_output=True,
        )
    subprocess.run(
        [secret_tool(), "clear", "application", PLUGIN_ID], capture_output=True
    )
    try:
        os.remove(ACCOUNT_FILE)
    except FileNotFoundError:
        pass


def stored_account() -> str | None:
    try:
        with open(ACCOUNT_FILE, encoding="utf-8") as handle:
            return handle.readline().strip() or None
    except OSError:
        return None


def write_account(account: str) -> None:
    os.makedirs(STATE_DIR, mode=0o700, exist_ok=True)
    os.chmod(STATE_DIR, 0o700)
    with open(ACCOUNT_FILE, "w", encoding="utf-8") as handle:
        handle.write(account + "\n")
    os.chmod(ACCOUNT_FILE, 0o600)


# --- token helpers -----------------------------------------------------------


def account_label(access_token: str) -> str:
    """Derive a stable keyring key from the token's claims.

    The signature is irrelevant here — this is a local label, not an
    authorization decision, so the payload is merely decoded, never trusted.
    """
    try:
        payload = access_token.split(".")[1]
        payload += "=" * (-len(payload) % 4)
        claims = json.loads(base64.urlsafe_b64decode(payload))
    except (IndexError, ValueError):
        return "default"
    for key in ("connect_id", "sub"):
        value = claims.get(key)
        if value:
            return f"prusa-{value}"
    return "default"


DEBUG = False


def post_token(fields: dict[str, str]) -> dict:
    body = urllib.parse.urlencode(fields).encode()
    request = urllib.request.Request(
        TOKEN_URL,
        data=body,
        headers={
            "Content-Type": "application/x-www-form-urlencoded",
            # Cloudflare fronts account.prusa3d.com and answers Python's default
            # User-Agent with a 1010 browser-signature ban, so identify the
            # plugin explicitly rather than letting urllib speak for itself.
            "User-Agent": USER_AGENT,
            "Accept": "application/json",
        },
        method="POST",
    )
    if DEBUG:
        # Field names and lengths only: the values are credentials.
        shape = ", ".join(f"{key}({len(value)} chars)" for key, value in fields.items())
        print(f"[debug] POST {TOKEN_URL}\n[debug] fields: {shape}", file=sys.stderr)
    try:
        with urllib.request.urlopen(request, timeout=30) as response:
            payload = json.loads(response.read())
            if DEBUG:
                print(f"[debug] HTTP 200, keys: {sorted(payload)}", file=sys.stderr)
            return payload
    except urllib.error.HTTPError as error:
        raw = ""
        detail = ""
        try:
            raw = error.read().decode(errors="replace")
            payload = json.loads(raw)
            detail = f": {payload.get('error', '')} {payload.get('error_description', '')}".rstrip()
        except (ValueError, OSError):
            pass
        if DEBUG:
            print(f"[debug] HTTP {error.code}\n[debug] body: {raw}", file=sys.stderr)
        raise LoginError(f"Prusa rejected the token request (HTTP {error.code}){detail}")
    except urllib.error.URLError as error:
        raise LoginError(f"could not reach account.prusa3d.com: {error.reason}")


def persist(tokens: dict) -> str:
    refresh_token = tokens.get("refresh_token")
    access_token = tokens.get("access_token", "")
    if not refresh_token:
        raise LoginError("Prusa returned no refresh token")
    account = account_label(access_token)
    store_refresh_token(account, refresh_token)
    write_account(account)
    nudge_widget()
    return account


def nudge_widget() -> None:
    """Ask a running bar widget to poll now rather than at its next interval.

    Best effort: no shell, no widget, or an older shell without the IPC method
    all fall through silently, and the widget catches up on its own schedule.
    """
    if not shutil.which("omarchy-shell"):
        return
    try:
        subprocess.run(
            ["omarchy-shell", "-q", PLUGIN_ID, "refresh"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=5,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        pass


# --- credential flow ---------------------------------------------------------
#
# What the Prusa mobile app does, and the only route Prusa leaves open to a
# third party: run the OAuth authorization-code + PKCE flow against
# account.prusa3d.com with Connect's registered redirect, but drive the sign-in
# form ourselves instead of a browser. The authorization code arrives in a
# redirect to connect.prusa3d.com, which is read from the Location header and
# never followed, so Connect's web app never sees the code and cannot spend it.
#
# This is form scraping. It breaks the day Prusa adds a captcha or renames a
# field, which is why --paste stays as the fallback.


class NoRedirect(urllib.request.HTTPRedirectHandler):
    """Surface 3xx responses instead of following them."""

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


class AccountSession:
    """A cookie-carrying HTTP session against account.prusa3d.com."""

    def __init__(self) -> None:
        self.jar = http.cookiejar.CookieJar()
        self.opener = urllib.request.build_opener(
            urllib.request.HTTPCookieProcessor(self.jar), NoRedirect()
        )

    def request(self, url: str, data: dict | None = None,
                referer: str | None = None) -> tuple[int, str, str]:
        """Return (status, location, body). Never follows a redirect."""
        headers = {"User-Agent": USER_AGENT, "Accept": "text/html,application/json"}
        if referer:
            headers["Referer"] = referer
        body = urllib.parse.urlencode(data).encode() if data is not None else None
        if body is not None:
            headers["Content-Type"] = "application/x-www-form-urlencoded"
        request = urllib.request.Request(url, data=body, headers=headers,
                                         method="POST" if body is not None else "GET")
        if DEBUG:
            fields = ", ".join(f"{k}({len(v)} chars)" for k, v in (data or {}).items())
            print(f"[debug] {request.get_method()} {url.split('?')[0]} fields: {fields}",
                  file=sys.stderr)
        try:
            with self.opener.open(request, timeout=30) as response:
                status = response.status
                location = ""
                text = response.read().decode(errors="replace")
        except urllib.error.HTTPError as error:
            status = error.code
            location = error.headers.get("Location", "") or ""
            text = error.read().decode(errors="replace") if status < 300 or status >= 400 else ""
        except urllib.error.URLError as error:
            raise LoginError(f"could not reach {ACCOUNT_HOST}: {error.reason}")
        if DEBUG:
            # Never the Location itself: past sign-in it carries the code.
            print(f"[debug] HTTP {status}"
                  + (f" -> {urllib.parse.urlsplit(location).netloc}" if location else ""),
                  file=sys.stderr)
        return status, location, text


def form_field(html: str, name: str) -> str | None:
    match = re.search(
        r'<input[^>]+name=["\']' + re.escape(name) + r'["\'][^>]*value=["\']([^"\']*)',
        html,
    )
    return match.group(1) if match else None


def form_has_field(html: str, name: str) -> bool:
    return re.search(r'<input[^>]+name=["\']' + re.escape(name) + r'["\']', html) is not None


def absolute(url: str) -> str:
    return url if urllib.parse.urlsplit(url).scheme else f"https://{ACCOUNT_HOST}{url}"


def ask_otp() -> str:
    try:
        return input("Two-factor code: ").strip()
    except (EOFError, KeyboardInterrupt):
        raise LoginError("cancelled")


def finish_sign_in(session: AccountSession, status: int, location: str,
                   html: str, url: str) -> str:
    """Take the flow from the credential POST to an authorization code.

    Prusa may answer the POST with a redirect straight to Connect, with a
    redirect chain through the authorize page, or with a further form: the
    sign-in form again (credentials refused) or a TOTP form. Handle whichever
    page comes up until a redirect points at Connect's callback.
    """
    for _ in range(12):
        if status in (301, 302, 303, 307, 308):
            target = absolute(location)
            if target.startswith(CONNECT_REDIRECT_URI):
                query = urllib.parse.parse_qs(urllib.parse.urlsplit(target).query)
                if query.get("error"):
                    detail = (query.get("error_description") or query["error"])[0]
                    raise LoginError(f"Prusa refused the sign-in: {detail}")
                code = (query.get("code") or [""])[0]
                if not code:
                    raise LoginError("Prusa returned no authorization code")
                return code
            if urllib.parse.urlsplit(target).netloc != ACCOUNT_HOST:
                raise LoginError("Prusa redirected somewhere unexpected: "
                                 + urllib.parse.urlsplit(target).netloc)
            url = target
            status, location, html = session.request(url)
            continue

        if status != 200:
            raise LoginError(f"unexpected response from Prusa during sign-in (HTTP {status})")

        if form_has_field(html, "otp_token"):
            csrf = form_field(html, "csrfmiddlewaretoken") or ""
            status, location, html = session.request(
                url, data={"csrfmiddlewaretoken": csrf, "otp_token": ask_otp()},
                referer=url)
            if status == 200 and form_has_field(html, "otp_token"):
                raise LoginError("Prusa rejected the two-factor code")
            continue

        if form_has_field(html, "password"):
            raise LoginError("Prusa rejected the email or password")

        if form_has_field(html, "allow"):
            raise LoginError(
                "Prusa is asking for consent on a page this script cannot\n"
                "answer. Use the paste route instead: prusa-connect-login --paste"
            )

        raise LoginError("Prusa showed a page this script does not recognise")

    raise LoginError("could not obtain an authorization code from Prusa")


def credential_login(email: str | None) -> None:
    verifier = base64.urlsafe_b64encode(secrets.token_bytes(64)).rstrip(b"=").decode()
    challenge = (
        base64.urlsafe_b64encode(hashlib.sha256(verifier.encode()).digest())
        .rstrip(b"=")
        .decode()
    )
    authorize = AUTHORIZE_URL + "?" + urllib.parse.urlencode({
        "client_id": CLIENT_ID,
        "response_type": "code",
        "redirect_uri": CONNECT_REDIRECT_URI,
        "scope": SCOPE,
        "code_challenge": challenge,
        "code_challenge_method": "S256",
    })

    session = AccountSession()

    # The authorize URL bounces an anonymous visitor to the sign-in form, with
    # the authorize request itself carried along in `next`.
    login_url = authorize
    status, location, html = session.request(login_url)
    while status in (301, 302, 303, 307, 308):
        login_url = absolute(location)
        status, location, html = session.request(login_url)
    if status != 200 or not form_has_field(html, "password"):
        raise LoginError(f"unexpected sign-in page from Prusa (HTTP {status})")
    csrf = form_field(html, "csrfmiddlewaretoken")
    if not csrf:
        raise LoginError("could not find the sign-in form's CSRF token")

    print("Sign in with your Prusa account. The password goes to "
          f"{ACCOUNT_HOST} only and is not stored.\n")
    try:
        if not email:
            email = input("Email: ").strip()
        password = getpass.getpass("Password: ")
    except (EOFError, KeyboardInterrupt):
        raise LoginError("cancelled")
    if not email or not password:
        raise LoginError("email and password are both required")

    form = {"csrfmiddlewaretoken": csrf, "email": email, "password": password}
    next_field = form_field(html, "next")
    if next_field is not None:
        form["next"] = next_field
    status, location, html = session.request(login_url, data=form, referer=login_url)
    del form, password

    code = finish_sign_in(session, status, location, html, login_url)
    tokens = post_token({
        "grant_type": "authorization_code",
        "client_id": CLIENT_ID,
        "code": code,
        "redirect_uri": CONNECT_REDIRECT_URI,
        "code_verifier": verifier,
    })
    account = persist(tokens)
    print(f"\nSigned in ({account}). The refresh token is in your GNOME keyring.")


# --- paste route -------------------------------------------------------------


def extract_refresh_token(pasted: str) -> str:
    """Accept a bare token, or the JSON blob a localStorage entry often holds."""
    pasted = pasted.strip().strip('"').strip()
    if not pasted:
        raise LoginError("no token given")
    if not pasted.startswith("{"):
        return pasted

    try:
        blob = json.loads(pasted)
    except ValueError:
        return pasted

    def find(node):
        if isinstance(node, dict):
            for key, value in node.items():
                if "refresh" in key.lower() and isinstance(value, str) and value:
                    return value
            for value in node.values():
                found = find(value)
                if found:
                    return found
        return None

    token = find(blob)
    if not token:
        raise LoginError("that JSON contains no refresh token field")
    return token


def token_claims(token: str) -> dict | None:
    """Decode a JWT payload without verifying it.

    Local triage only — never an authorization decision — so an unverified
    decode is appropriate here.
    """
    try:
        payload = token.split(".")[1]
        payload += "=" * (-len(payload) % 4)
        claims = json.loads(base64.urlsafe_b64decode(payload))
    except (IndexError, ValueError):
        return None
    return claims if isinstance(claims, dict) else None


def reject_access_token(token: str) -> None:
    """Refuse an access token pasted in place of a refresh token.

    Connect stores both in localStorage under adjacent keys, and both are JWTs,
    so only the 'type' claim tells them apart. Saying which one was pasted beats
    relaying a bare 'invalid_grant' from Prusa.
    """
    claims = token_claims(token)
    if claims and claims.get("type") == "access":
        raise LoginError(
            "that is an access token, not a refresh token.\n\n"
            "It is the value of 'auth.access_token', which expires in about two\n"
            "hours and cannot be renewed. Copy 'auth.refresh_token' instead."
        )


def stdin_login() -> None:
    """Take the refresh token on stdin, for scripted or assisted setup."""
    token = extract_refresh_token(sys.stdin.read())
    reject_access_token(token)
    tokens = post_token({
        "grant_type": "refresh_token",
        "client_id": CLIENT_ID,
        "refresh_token": token,
    })
    account = persist(tokens)
    print(f"Accepted ({account}). The refresh token is in your GNOME keyring.")


def paste_login() -> None:
    print(
        "Paste a Prusa Connect refresh token.\n\n"
        "In the browser, with Connect open and signed in:\n"
        "  DevTools -> Application -> Local Storage -> https://connect.prusa3d.com\n"
        "  copy the value of the entry whose key mentions 'refresh'.\n\n"
        "Either the bare token or the whole JSON value will do.\n\n"
        "Treat it like a password: it grants access to your account until you\n"
        "sign out of Connect.\n"
    )
    try:
        token = extract_refresh_token(input("Refresh token: "))
    except (EOFError, KeyboardInterrupt):
        raise LoginError("cancelled")
    reject_access_token(token)

    # Exchange it once, both to validate it and to pick up a rotated token.
    tokens = post_token({
        "grant_type": "refresh_token",
        "client_id": CLIENT_ID,
        "refresh_token": token,
    })
    account = persist(tokens)
    print(f"\nAccepted ({account}). The refresh token is in your GNOME keyring.")


# --- status ------------------------------------------------------------------


def show_status() -> int:
    account = stored_account()
    if not account:
        print("Not signed in.")
        return 1
    if lookup_refresh_token(account):
        print(f"Signed in as {account} (refresh token in GNOME keyring).")
        return 0
    print(f"Account {account} is configured, but the keyring holds no refresh token.")
    return 1


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Sign in to Prusa Connect for the Omarchy plugin.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    group = parser.add_mutually_exclusive_group()
    group.add_argument("--paste", action="store_true",
                       help="paste a refresh token instead of signing in")
    group.add_argument("--stdin", action="store_true",
                       help="read the refresh token from stdin")
    group.add_argument("--status", action="store_true",
                       help="report whether credentials are present")
    group.add_argument("--forget", action="store_true",
                       help="remove stored credentials")
    parser.add_argument("--email", help="Prusa account email (asked for if omitted)")
    parser.add_argument("--debug", action="store_true",
                        help="print request shape and raw responses to stderr")
    args = parser.parse_args()

    global DEBUG
    DEBUG = args.debug

    try:
        if args.status:
            return show_status()
        if args.forget:
            clear_credentials()
            print("Prusa Connect credentials removed.")
            return 0
        if args.stdin:
            stdin_login()
            return 0
        if args.paste:
            paste_login()
            return 0
        credential_login(args.email)
        return 0
    except LoginError as error:
        print(f"\nprusa-connect-login: {error}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        print("\ncancelled", file=sys.stderr)
        return 130


if __name__ == "__main__":
    sys.exit(main())
