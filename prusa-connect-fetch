#!/bin/bash

# Fetch the Prusa Connect printer fleet and print it as the flat model the
# widget renders.
#
# Usage: prusa-connect-fetch
#
# Prints the normalized document on success, or {"error":"…"} on failure —
# exiting 0 either way so the widget can render the reason instead of guessing
# why a process died. A failure that the user can fix carries "needsLogin": true.
#
# The refresh token lives in the GNOME keyring and never reaches argv: it is
# handed to curl over stdin. Prusa rotates refresh tokens on use, so a rotated
# token is written back to the keyring immediately.

set -uo pipefail
umask 077

readonly PRINTERS_URL="https://connect.prusa3d.com/app/printers"
readonly PAGE_LIMIT=100

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly SCRIPT_DIR
readonly NORMALIZE="$SCRIPT_DIR/normalize.jq"

# shellcheck source=lib/prusa-auth.sh
source "$SCRIPT_DIR/lib/prusa-auth.sh" || {
  printf '{"error":"lib/prusa-auth.sh is missing from the plugin folder"}\n'
  exit 0
}

prusa_require_commands
[[ -r $NORMALIZE ]] || die "normalize.jq is missing from the plugin folder"

prusa_ensure_access_token || prusa_fail
ACCESS_TOKEN="$PRUSA_ACCESS_TOKEN"

# --- fetch, paging until the fleet is complete -------------------------------

fetch_page() {
  local offset="$1" response code
  response=$(
    printf 'url = "%s?limit=%s&offset=%s"\nheader = "Authorization: Bearer %s"\nheader = "Accept: application/json"\nsilent\nshow-error\n' \
      "$PRINTERS_URL" "$PAGE_LIMIT" "$offset" "$ACCESS_TOKEN" |
      curl --config - -m 30 -w '\n%{http_code}'
  )
  code=$(tail -n1 <<<"$response")
  printf '%s' "$code" >"$PRUSA_CACHE_DIR/.last-code"
  sed '$d' <<<"$response"
}

raw=$(fetch_page 0)
code=$(<"$PRUSA_CACHE_DIR/.last-code")
rm -f "$PRUSA_CACHE_DIR/.last-code"

case "$code" in
  200) ;;
  401|403)
    # The cached token was rejected; drop it so the next run renews cleanly.
    rm -f "$PRUSA_TOKEN_FILE"
    die_needs_login "Prusa Connect rejected the session — run prusa-connect-login" ;;
  429) die "Prusa Connect is rate limiting — try again shortly" ;;
  "" ) die "Could not reach Prusa Connect" ;;
  *)   die "Prusa Connect returned HTTP $code" ;;
esac

jq -e . >/dev/null 2>&1 <<<"$raw" || die "Prusa Connect returned a malformed response"

total=$(jq -r '.pager.total // (.printers | length)' <<<"$raw")
[[ $total =~ ^[0-9]+$ ]] || total=0

if (( total > PAGE_LIMIT )); then
  offset=$PAGE_LIMIT
  while (( offset < total )); do
    page=$(fetch_page "$offset")
    rm -f "$PRUSA_CACHE_DIR/.last-code"
    jq -e . >/dev/null 2>&1 <<<"$page" || break
    raw=$(jq -s '.[0] * {printers: (.[0].printers + .[1].printers)}' \
      <(printf '%s' "$raw") <(printf '%s' "$page")) || break
    (( offset += PAGE_LIMIT ))
  done
fi

unset ACCESS_TOKEN

jq -f "$NORMALIZE" <<<"$raw" 2>/dev/null || die "Could not interpret the Prusa Connect response"
