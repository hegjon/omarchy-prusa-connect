#!/bin/bash

# Exercise normalize.jq against captured and synthetic Connect responses.
# No credentials and no network: everything here runs off fixtures.

set -uo pipefail

TEST_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly TEST_DIR
PLUGIN_DIR="$(dirname -- "$TEST_DIR")"
readonly PLUGIN_DIR
readonly NORMALIZE="$PLUGIN_DIR/normalize.jq"

passed=0
failed=0

check() {
  local name="$1" fixture="$2" filter="$3"
  local out
  if ! out=$(jq -f "$NORMALIZE" <"$TEST_DIR/fixtures/$fixture" 2>&1); then
    printf '  FAIL  %s\n        normalize.jq errored: %s\n' "$name" "$out"
    (( failed++ ))
    return
  fi
  if jq -e "$filter" >/dev/null 2>&1 <<<"$out"; then
    printf '  ok    %s\n' "$name"
    (( passed++ ))
  else
    printf '  FAIL  %s\n        expected: %s\n' "$name" "$filter"
    (( failed++ ))
  fi
}

echo "normalize.jq"

# --- captured fleet: three printers, one live, two long offline -------------
check "counts the whole fleet" printers.json \
  '.summary.total == 3'
check "counts only the connected printer as online" printers.json \
  '.summary.online == 1'
check "counts both disconnected printers as offline" printers.json \
  '.summary.offline == 2'

# Connect keeps reporting a stale printer_state for a printer that has been
# unreachable for months; liveness has to win or the panel lies.
check "stale ATTENTION on a disconnected printer reads as OFFLINE" printers.json \
  '(first(.printers[] | select(.name == "Workshop MK4")) | .state == "OFFLINE" and .printerState == "ATTENTION")'
check "a disconnected printer's stale ATTENTION does not count" printers.json \
  '(first(.printers[] | select(.name == "Workshop MK4")) | .needsAttention == false)'

# Printers are addressed by name, not position: normalize.jq sorts offline
# printers last, so an index encodes an assumption about ordering.
# Fields Connect omits entirely for a disconnected printer.
check "missing temps normalize to null rather than erroring" printers.json \
  '(first(.printers[] | select(.name == "Workshop MK4")) | .temps == null)'
check "missing job normalizes to null" printers.json \
  '(first(.printers[] | select(.name == "Workshop MK4")) | .job == null)'
check "material survives from the filament field" printers.json \
  '(first(.printers[] | select(.name == "Workshop MK4")) | .material == "PETG")'

# The live XL reports two tools and a pending dialog.
check "reads temperatures from a live printer" printers.json \
  '(first(.printers[] | select(.name == "Studio XL")) | .temps.nozzle == 19.0 and .temps.bed == 18.3)'
check "keeps both tools, in index order" printers.json \
  '(first(.printers[] | select(.name == "Studio XL")) | (.tools | length) == 2 and .tools[0].index == 1)'
check "surfaces the pending dialog as the attention reason" printers.json \
  '(first(.printers[] | select(.name == "Studio XL")) | .attention.title == "DISPLAY PROBLEM DETECTED")'
check "a printer with no dialog has no attention reason" printers.json \
  '(first(.printers[] | select(.name == "Workshop MK4")) | .attention == null)'

# An unanswered dialog means a printer wants a human even when its state does
# not say so — the XL reports FINISHED with a dialog still on screen.
check "a reachable printer with a dialog needs attention" printers.json \
  '(first(.printers[] | select(.name == "Studio XL")) | .needsAttention == true)'
check "the fleet summary counts it" printers.json \
  '.summary.attention == 1'

# --- needsAttention boundaries ----------------------------------------------
echo
echo "needsAttention"
check "FINISHED with an unanswered dialog needs attention" attention.json \
  '(first(.printers[] | select(.name == "Finished with dialog")) | .needsAttention == true)'
check "a stale dialog on an unreachable printer does not" attention.json \
  '(first(.printers[] | select(.name == "Offline with stale dialog")) | .needsAttention == false)'
check "ATTENTION without a dialog still needs attention" attention.json \
  '(first(.printers[] | select(.name == "Attention without dialog")) | .needsAttention == true)'
check "an idle printer does not" attention.json \
  '(first(.printers[] | select(.name == "Quietly idle")) | .needsAttention == false)'
check "the summary counts exactly the two that qualify" attention.json \
  '.summary.attention == 2'

# Once anything has been extruded it is no longer preparing, and a printer that
# is not printing at all never is.
# A printer cooling down after a finished job can still report PRINTING with a
# reset or absent job. That looked identical to warmup and briefly read as
# "Preparing" while the printer's own display said 100%.
for case in \
  '{"printer_state":"PRINTING","connect_state":"PRINTING","job_info":{"id":1,"display_name":"x.bgcode","progress":100.0,"state":"FIN_OK","end":1786874596}}' \
  '{"printer_state":"PRINTING","connect_state":"PRINTING","job_info":{"id":1,"display_name":"x.bgcode","progress":0.0,"end":1786874596}}' \
  '{"printer_state":"PRINTING","connect_state":"PRINTING"}'
do
  if jq -f "$NORMALIZE" <<<"{\"printers\":[$case]}" |
     jq -e '.printers[0].preparing == false' >/dev/null 2>&1; then
    printf '  ok    a finished or absent job is not preparing\n'
    passed=$(( passed + 1 ))
  else
    printf '  FAIL  a finished or absent job is not preparing: %s\n' "$case"
    failed=$(( failed + 1 ))
  fi
done
if jq -f "$NORMALIZE" <<<'{"printers":[{"printer_state":"PRINTING","connect_state":"PRINTING","job_info":{"id":1,"display_name":"x.bgcode","progress":0.0,"time_remaining":60}}]}' |
   jq -e '.printers[0].preparing == true' >/dev/null 2>&1; then
  printf '  ok    a printing job at zero progress is preparing\n'
  passed=$(( passed + 1 ))
else
  printf '  FAIL  a printing job at zero progress is preparing\n'
  failed=$(( failed + 1 ))
fi
if jq -f "$NORMALIZE" <<<'{"printers":[{"printer_state":"PRINTING","connect_state":"PRINTING","job_info":{"id":1,"display_name":"x.bgcode","progress":12.0,"time_remaining":60}}]}' |
   jq -e '.printers[0].preparing == false' >/dev/null 2>&1; then
  printf '  ok    a job past zero progress is not preparing\n'
  passed=$(( passed + 1 ))
else
  printf '  FAIL  a job past zero progress is not preparing\n'
  failed=$(( failed + 1 ))
fi
if jq -f "$NORMALIZE" <<<'{"printers":[{"printer_state":"FINISHED","connect_state":"FINISHED"}]}' |
   jq -e '.printers[0].preparing == false' >/dev/null 2>&1; then
  printf '  ok    a printer that is not printing is not preparing\n'
  passed=$(( passed + 1 ))
else
  printf '  FAIL  a printer that is not printing is not preparing\n'
  failed=$(( failed + 1 ))
fi

# --- ordering ---------------------------------------------------------------
echo
echo "ordering"
# Connect returns these by name: Workshop MK4 (offline), Studio XL (online),
# Spare MK4 (offline). The reachable one should come first.
check "the reachable printer sorts above the unreachable ones" printers.json \
  '[.printers[].name] == ["Studio XL", "Workshop MK4", "Spare MK4"]'
check "offline printers keep Connect's relative order" printers.json \
  '[.printers[] | select(.online | not) | .name] == ["Workshop MK4", "Spare MK4"]'
check "sorting does not lose or duplicate anyone" printers.json \
  '(.printers | length) == 3 and ([.printers[].uuid] | unique | length) == 3'
check "summary counts are unaffected by ordering" printers.json \
  '.summary.total == 3 and .summary.online == 1 and .summary.offline == 2'

# --- printer artwork ---------------------------------------------------------
echo
echo "artwork"
# Input Shaper is firmware, not a different chassis: MK4IS looks like an MK4.
check "MK4IS maps to the mk4 illustration" printers.json \
  '(first(.printers[] | select(.name == "Workshop MK4")) | .assetKey == "mk4")'
# The XL's artwork depends on how many tools it carries.
check "a two-tool XL maps to the two-tool illustration" printers.json \
  '(first(.printers[] | select(.name == "Studio XL")) | .assetKey == "xlmultitool2")'
check "an unknown model falls back rather than erroring" attention.json \
  '(.printers | map(.assetKey) | all(. != null and . != ""))'

# Every key the normalizer emits must have a file, or the panel shows a gap.
for key in $(jq -f "$NORMALIZE" <"$TEST_DIR/fixtures/printers.json" | jq -r '.printers[].assetKey'); do
  if [[ -f "$PLUGIN_DIR/assets/printers/$key.svg" ]]; then
    printf '  ok    %s.svg is bundled\n' "$key"
    (( passed++ ))
  else
    printf '  FAIL  %s.svg is missing from assets/printers/\n' "$key"
    (( failed++ ))
  fi
done
if [[ -f "$PLUGIN_DIR/assets/printers/unknown.svg" ]]; then
  printf '  ok    the unknown fallback is bundled\n'
  (( passed++ ))
else
  printf '  FAIL  assets/printers/unknown.svg is missing\n'
  (( failed++ ))
fi

# --- captured printing job ---------------------------------------------------
echo
echo "printing"
check "counts a printing printer" printing.json \
  '.summary.printing == 1'
check "reads the job name Connect reports" printing.json \
  '(first(.printers[] | select(.name == "Busy MK4")) | .job.name == "Shape-Cylinder_0.4n_0.2mm_PETG_MK4IS_45s.bgcode")'
# progress is a percentage, not a fraction: the capture reads 1.0 while
# weight_remaining is still 99% of model_weight. Scaling would be wrong by 100x.
check "passes progress through as a percentage" printing.json \
  '(first(.printers[] | select(.name == "Busy MK4")) | .job.progress == 1.0)'
check "reads elapsed print time" printing.json \
  '(first(.printers[] | select(.name == "Busy MK4")) | .job.elapsed == 117)'
# Connect says 0 when the printer has no estimate yet, which must not render as
# "ETA 0s" — that would claim a job two minutes old is about to finish.
check "treats a zero time estimate as unknown" printing.json \
  '(first(.printers[] | select(.name == "Busy MK4")) | .job.remaining == null)'
# The same job reported 0 at 117 seconds in and -1 at 228: both mean "no
# estimate yet", so both must normalize away rather than reaching the panel.
if jq -f "$NORMALIZE" <<<'{"printers":[{"printer_state":"PRINTING","connect_state":"PRINTING","job_info":{"id":1,"display_name":"x.bgcode","progress":1.0,"time_remaining":-1,"time_printing":228}}]}' |
   jq -e '.printers[0].job.remaining == null' >/dev/null 2>&1; then
  printf '  ok    treats a negative time estimate as unknown\n'
  passed=$(( passed + 1 ))
else
  printf '  FAIL  treats a negative time estimate as unknown\n'
  failed=$(( failed + 1 ))
fi
# Zero is the only value treated as unknown; a real estimate must survive.
if jq -f "$NORMALIZE" <<<'{"printers":[{"printer_state":"PRINTING","connect_state":"PRINTING","job_info":{"id":1,"display_name":"x.bgcode","progress":42.5,"time_remaining":4320,"time_printing":1800}}]}' |
   jq -e '.printers[0].job.remaining == 4320 and .printers[0].job.progress == 42.5' >/dev/null 2>&1; then
  printf '  ok    a non-zero remaining time survives\n'
  passed=$(( passed + 1 ))
else
  printf '  FAIL  a non-zero remaining time survives\n'
  failed=$(( failed + 1 ))
fi
# The captured fixture sits at 1%, just past the line, so it is no longer
# preparing. Live observation showed 1% arriving while the nozzle was still
# climbing to print temperature, but progress leaving zero is the only
# principled boundary available — Connect exposes no phase, and temperature
# cannot separate heating from bed levelling.
check "a job past zero progress is not preparing" printing.json \
  '(first(.printers[] | select(.name == "Busy MK4")) | .preparing == false)'
check "reads targets while heating" printing.json \
  '(first(.printers[] | select(.name == "Busy MK4")) | .temps.nozzleTarget == 175.0 and .temps.bedTarget == 85.0)'

# --- degenerate input -------------------------------------------------------
echo
echo "degenerate input"
for payload in '{}' '{"printers":[]}' '{"printers":[{}]}'; do
  if out=$(jq -f "$NORMALIZE" <<<"$payload" 2>&1); then
    printf '  ok    survives %s\n' "$payload"
    (( passed++ ))
  else
    printf '  FAIL  %s errored: %s\n' "$payload" "$out"
    (( failed++ ))
  fi
done

# A printer object with nothing in it must still yield a renderable row.
if jq -f "$NORMALIZE" <<<'{"printers":[{}]}' |
   jq -e '.printers[0].state == "OFFLINE" and .printers[0].name == "Printer"' >/dev/null 2>&1; then
  printf '  ok    an empty printer object still renders\n'
  (( passed++ ))
else
  printf '  FAIL  an empty printer object still renders\n'
  (( failed++ ))
fi

echo
printf '%d passed, %d failed\n' "$passed" "$failed"
(( failed == 0 ))
